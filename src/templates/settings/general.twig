{% extends 'cookie-consent-kit/settings/_layout' %}

{% import '_includes/forms' as forms %}
{% import 'cookie-consent-kit/settings/_macros' as helper %}

{% set title = 'General'|t('cookie-consent-kit') %}

{% block pane %}

    {{ forms.selectField({
        label: 'Fallback language'|t('cookie-consent-kit'),
        instructions: 'Used when the current locale has no wording. The list holds the languages the plugin ships with, plus any the site adds in translations/vendor/cookie-consent-kit.'|t('cookie-consent-kit'),
        id: 'defaultLanguage',
        name: 'defaultLanguage',
        options: languageOptions,
        value: settings.defaultLanguage,
        errors: settings.getErrors('defaultLanguage'),
        disabled: overrides.defaultLanguage is defined,
        warning: helper.lockNote(overrides, 'defaultLanguage'),
        required: true,
    }) }}

{% endblock %}
