{
    "name": "quebecstudio-mods/craftcms-consent-kit",
    "description": "Opt-in cookie consent for Craft CMS: no third-party cookie, script or embed loads before the visitor agrees. Built for Quebec's Law 25 and the GDPR.",
    "type": "craft-plugin",
    "license": "proprietary",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "consent",
        "cookies",
        "loi25",
        "rgpd"
    ],
    "authors": [
        {
            "name": "Québec Studio",
            "homepage": "https://quebecstudio.com"
        }
    ],
    "support": {
        "email": "info@quebecstudio.com",
        "issues": "https://github.com/quebecstudio-mods/craftcms-consent-kit/issues",
        "source": "https://github.com/quebecstudio-mods/craftcms-consent-kit",
        "docs": "https://github.com/quebecstudio-mods/craftcms-consent-kit/blob/6.x/README.md"
    },
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0",
        "quebecstudio-mods/consent-kit-core": "^1.3"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^3.0 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "QuebecStudioMods\\ConsentKit\\CraftCms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QuebecStudioMods\\ConsentKit\\CraftCms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "style": "@php vendor/bin/pint --test",
        "stan": "@php -d memory_limit=512M vendor/bin/phpstan analyse --no-progress",
        "types": "@php -d memory_limit=512M vendor/bin/pest --type-coverage --compact --min=100",
        "check": [
            "@style",
            "@stan",
            "@types",
            "@test"
        ],
        "refactor": "@php -d memory_limit=512M vendor/bin/rector process --dry-run"
    },
    "extra": {
        "handle": "cookie-consent-kit",
        "name": "Cookie Consent Kit",
        "description": "Opt-in cookie consent for Craft CMS: no third-party cookie, script or embed loads before the visitor agrees. Built for Quebec's Law 25 and the GDPR.",
        "developer": "Québec Studio Mods",
        "developerUrl": "https://github.com/quebecstudio-mods",
        "developerEmail": "info@quebecstudio.com",
        "documentationUrl": "https://github.com/quebecstudio-mods/craftcms-consent-kit/blob/6.x/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/quebecstudio-mods/craftcms-consent-kit/6.x/CHANGELOG.md",
        "class": "QuebecStudioMods\\ConsentKit\\CraftCms\\Plugin",
        "branch-alias": {
            "dev-6.x": "6.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
